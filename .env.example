# ============================================================
# Horse Racing Predictor — API Credentials
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
#
# You only need ONE of these API sources. Both have free tiers.
# ============================================================

# --- The Racing API (recommended) ---
# Sign up free: https://www.theracingapi.com
# Free tier: daily racecards + results for UK & Ireland
RACING_API_USERNAME=
RACING_API_PASSWORD=

# --- RapidAPI Horse Racing (alternative) ---
# Sign up free: https://rapidapi.com/ortegalex/api/horse-racing
# Free tier: 50 requests/day, UK & Ireland racecards + results
RAPIDAPI_KEY=

# --- Betfair Historical Data (sole ongoing Betfair source: full market files) ---
# Easiest setup: betfair_history.connect_account (see
# docs/operations/BETFAIR_HISTORY_AUTOMATION.md), which stores login settings
# encrypted for your Windows account.
# Alternatively configure these locally; do not commit credentials/private keys.
# Upload the PUBLIC login certificate to Betfair account security once.
# A paid Live App Key is NOT required for certificate login/historical downloads.
# BETFAIR_HISTORY_ENABLED=true
# BETFAIR_USERNAME=
# BETFAIR_PASSWORD=
# BETFAIR_CERT_FILE=C:/absolute/path/to/client.crt
# BETFAIR_KEY_FILE=C:/absolute/path/to/client.key
# A temporary session token can be used instead; it will eventually expire.
# BETFAIR_SESSION_TOKEN=
